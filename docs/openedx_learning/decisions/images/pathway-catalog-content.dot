digraph pathway_catalog_content {
    rankdir=LR;
    fontname="Helvetica";
    compound=true;
    node [shape=box, style=rounded, fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10];

    subgraph cluster_catalog {
        label="openedx_catalog (not versioned)";
        fontsize=10;
        fontcolor="#4d4d4d";
        style=dashed;
        color="#b3b3b3";
        catalog [label="Catalog Pathway\n\nname, category,\ndescription, SEO"];
        courserun [label="CourseRun"];
    }

    subgraph cluster_content {
        label="openedx_learning (versioned)";
        labelloc="b";
        fontsize=10;
        fontcolor="#4d4d4d";
        style=dashed;
        color="#b3b3b3";
        pathway [label="Pathway"];
        v1 [label="version 1\n\nItems, criteria"];
        v2 [label="version 2\n\nItems, criteria\n(currently published)"];
        pathway -> v1 [style=dotted, color="#808080", arrowsize=0.7];
        pathway -> v2 [style=dotted, color="#808080", arrowsize=0.7];
        v1 -> v2 [style=dotted, color="#808080", arrowsize=0.7, label="revision"];
    }

    user [label="User", shape=ellipse];
    enrollment [label="Enrollment"];

    user -> enrollment [label="learner"];
    enrollment -> catalog [label="enrolled in"];
    enrollment -> v2 [label="progress evaluated\nagainst the currently\npublished version", style=dashed, color="#808080", fontcolor="#4d4d4d"];

    pathway -> catalog [label="implements\n(one-to-one, fixed)"];
    v2 -> courserun [label="Items reference"];

    direction [label="dependency direction:\nthe content side knows about\nopenedx_catalog, never the reverse", shape=plaintext, fontsize=10, fontcolor="#4d4d4d"];
}
